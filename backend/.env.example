# Copiar a .env y completar. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=3000

# MySQL (el script físico es /scripts/sch.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=stockbar_app
DB_PASSWORD=
DB_NAME=stockbar
# Zona horaria de la sesión MySQL: CURDATE() de los triggers (vencimientos,
# edad) y los filtros por fecha usan la hora de Colombia.
DB_TIMEZONE=-05:00
# MySQL gestionado en la nube: DB_SSL=true y, si el proveedor lo entrega,
# la ruta a su certificado CA.
DB_SSL=false
DB_SSL_CA=

# JWT: secreto aleatorio de al menos 32 caracteres
JWT_SECRET=
JWT_EXPIRA=8h

# Orígenes permitidos para la app web (separados por coma). En producción
# es obligatorio: el dominio HTTPS real del frontend.
CORS_ORIGINS=http://localhost:5173

# HTTPS (obligatorio en producción). Si el TLS lo termina el proveedor cloud
# (load balancer), dejar vacío; si no, rutas a la llave y al certificado.
SSL_KEY=
SSL_CERT=

# SMTP (recuperación de contraseña y bienvenida). Sin SMTP_HOST, en desarrollo
# el correo se imprime en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StockBar <no-reply@stockbar.com>

# Facturas de compra digitalizadas (fuera del código fuente)
UPLOAD_DIR=./uploads

# Primer administrador (administrador principal). Solo se usa si la tabla
# usuario está vacía, en el primer arranque.
ADMIN_CORREO=administrador@stockbar.com
ADMIN_CONTRASENA=
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=Principal
ADMIN_TIPO_DOCUMENTO=CC
ADMIN_NUMERO_DOCUMENTO=0000000001
