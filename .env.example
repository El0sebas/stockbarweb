# Copiar a .env (nunca se sube al repositorio).

# --- Docker local (docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
# Aleatorio, 32 caracteres o más (por ejemplo: openssl rand -hex 32)
JWT_SECRET=
# Administrador principal: solo se usa en el primer arranque (base vacía).
ADMIN_CORREO=administrador@stockbar.com
# 8 a 72 caracteres, con letras y números
ADMIN_CONTRASENA=
# Correo para "¿Olvidaste tu contraseña?" (opcional; sin esto no llega el token)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StockBar <no-reply@stockbar.com>

# --- Compilar la web para la nube (no usar en .env: afectaría `npm run dev`) ---
# Escribirla en .env.production.local antes de `npm run build`:
# VITE_API_URL=https://api.tu-dominio.com/api
